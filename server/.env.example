# WeatherGPT Server Environment Variables
# Copy this to .env and fill in your actual values

# Gemini API Key (required)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (required for chat persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Server Port (optional, defaults to 3001)
PORT=3001

# IMD API Credentials (OPTIONAL - currently disabled)
# IMD data requires authenticated API access with static IP registration
# All IMD endpoints are currently disabled and return 503 unavailable
# Uncomment the lines below if you have registered your server IP with IMD
# IMD_API_KEY=your_imd_api_key_here
# IMD_API_EMAIL=your_imd_registered_email_here
# IMD_API_PASSWORD=your_imd_registered_password_here
